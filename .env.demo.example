# Демо-бот (см. docker-compose.demo.yml). Остальное (ключи ИИ, ADMIN_TELEGRAM_ID)
# берётся из основного .env. Значения — без кавычек и без <>.
#
# Новый бот в @BotFather и ПУБЛИЧНЫЙ канал; бота добавить в канал админом.
BOT_TOKEN=
CHANNEL_ID=@your_demo_channel
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/realtor_demo
REDIS_URL=redis://redis:6379/1
DEMO_MODE=true
# Пусто = polling (вебхук основного бота не трогаем)
WEBHOOK_URL=
# Бренд демо в постах канала: твои контакты продавца бота
AGENCY_NAME=Demo Uylar
AGENCY_CONTACTS=+998900000000:your_username
CHANNEL_URL=https://t.me/your_demo_channel
BOT_PUBLISH_URL=https://t.me/your_demo_bot?start=add
WATERMARK_TEXT=Demo Uylar
# Сколько объявлений в день может разместить один посетитель
DEMO_DAILY_LIMIT=3
SENTRY_ENV=demo
