BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_ID=your_telegram_id
CHANNEL_ID=@your_channel_username

DATABASE_URL=postgresql+asyncpg://user:password@db:5432/realtor
REDIS_URL=redis://redis:6379/0

# --- Webhook (опционально). Пусто → polling. Для webhook заполните всё ниже
#     и запускайте: docker compose -f docker-compose.yml -f docker-compose.webhook.yml up -d
DOMAIN=
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8080

# --- ИИ (опционально). Всё можно оставить пустым — бот работает офлайн. ---
# Вариант A: любой OpenAI-совместимый провайдер (бесплатные/дешёвые).
#   Groq (бесплатно):    LLM_BASE_URL=https://api.groq.com/openai/v1
#                        AI_MODEL=openai/gpt-oss-120b
#   Gemini (бесплатно):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                        AI_MODEL=gemini-flash-latest
#   DeepSeek (копейки):  LLM_BASE_URL=https://api.deepseek.com
#                        AI_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_API_KEY=
# Вариант B: Anthropic (если LLM_BASE_URL пуст). Опустите оба — будет офлайн.
ANTHROPIC_API_KEY=
# Модель под выбранного провайдера (для Anthropic, например, claude-haiku-4-5-20251001)
AI_MODEL=claude-haiku-4-5-20251001

# --- РЕЗЕРВНЫЕ ИИ-ПРОВАЙДЕРЫ (рекомендуется 2+ ключа!) ---
# Бот сам переключается на следующий, если у одного сняли модель/кончился лимит.
# Достаточно вписать ключи — цепочка соберётся автоматически.
# Проверка в боте (админ): /ai_status   Список моделей: /ai_models groq
# openrouter.ai — один ключ, сотни моделей (лучший резерв)
OPENROUTER_API_KEY=
# platform.deepseek.com — очень дёшево
DEEPSEEK_API_KEY=
# cloud.cerebras.ai — бесплатный лимит, быстрый
CEREBRAS_API_KEY=
# console.mistral.ai
MISTRAL_API_KEY=
# Необязательно: явный порядок «провайдер[:модель]»
# LLM_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-flash-latest,openrouter
# Переопределить модель провайдера: GROQ_MODEL=, GEMINI_MODEL=, OPENROUTER_MODEL=, …

# --- Распознавание скринов объявлений (Vision) — Google Gemini ---
# Ключ с aistudio.google.com. Пусто → функция выключена.
GEMINI_API_KEY=
VISION_MODEL=gemini-flash-latest

# --- Голосовые объявления (узбекский и др.) — Groq Whisper ---
# Ключ с console.groq.com. Пусто → функция выключена.
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
# ElevenLabs Scribe — заметно лучше Whisper на УЗБЕКСКОМ (если задан — идёт первым)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Резерв для Vision через OpenRouter (модель с поддержкой картинок)
# OPENROUTER_VISION_MODEL=

# --- Авто-репост из чужих каналов (юзербот Telethon, задача 7) ---
# Включается отдельным override: docker-compose.userbot.yml
# API_ID/API_HASH — с https://my.telegram.org. USERBOT_SESSION — из
# scripts/userbot_login.py. Используйте ОТДЕЛЬНЫЙ номер (ToS Telegram!).
USERBOT_ENABLED=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_SESSION=
# Каналы-источники через запятую: @channel1,@channel2 (или t.me/... , или id)
SOURCE_CHANNELS=
# moderate — в модерацию (безопасно), auto — сразу в канал
AUTOREPOST_MODE=moderate
AUTOREPOST_MAX_PHOTOS=10

# Водяной знак на фото в канале (пусто = выключить)
WATERMARK_TEXT=Фарғона Уйлари

# Логи: LOG_LEVEL=INFO|DEBUG|WARNING, LOG_FORMAT=plain|json
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Бэкапы базы (сервис backup делает дамп каждую ночь после 03:00).
# Куда бот шлёт копию файла в 04:10: id чата/канала. Пусто → первому админу.
BACKUP_CHAT_ID=

# Sentry (опционально) — включается при заданном DSN
SENTRY_DSN=
SENTRY_ENV=production
